---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
---

<!doctype html>
<html lang="en">
	<title>Josh Salazar Portfolio - 404</title>

	<head>
		<BaseHead title={`Page Not Found | ${SITE_TITLE}`} description="This page doesn't exist." />
		<Font cssVariable="--font-kanit" />
	</head>
	<body>
		<Header />
		<main>
			<div class="not-found">
				<div class="svg-container">
					<svg
						id="Layer_1"
						viewBox="0 0 500 500"
						preserveAspectRatio="xMinYMin meet"
						class="svg-content"
						aria-hidden="true"
					>
						<g id="LeftLeg">
							<polyline
								id="LeftLegPortion"
								class="st0"
								points="210.67,413.11 210.67,392.78 210.67,366.56"></polyline>
							<line id="LeftFoot" class="st0" x1="196.37" y1="419.22" x2="210.67" y2="413.66"></line>
						</g>
						<g id="RightLeg">
							<line id="RightFoot" class="st0" x1="269.04" y1="417.61" x2="254.75" y2="412.06"></line>
							<polyline
								id="RightLegPortion"
								class="st1"
								points="254.75,413.11 254.75,392.78 254.75,366.56"></polyline>
						</g>
						<path
							id="Body"
							class="st2"
							d="M253.22,263.44h-44.56c-11.03,0-10.27,2.06-10.27,20.06s-16.5,49.06-16.5,66.11
							s9.03,28.22,20.06,28.22h62.56c11.03,0,20.06-8.03,20.06-28.22s-19.67-46.06-19.67-66.11C264.89,263.47,264.25,263.44,253.22,263.44
							z"></path>
						<g id="HeadGroup">
							<path
								id="Hair"
								class="st3"
								d="M198.56,75.44c0,0,2.55-11.11-11.12-11.11c-18.11,0-18.56,18.97-1.66,29.89c12.56,8.11,9.48,7.21,9.92,21.67"
							></path>
							<path
								id="Head"
								class="st2"
								d="M278.49,110.72h-86.55c-24.46,0-52.05,31.27-56.22,44.47c-4.18,13.2-16.41,32.72-16.41,67.12
								s80.06,58.77,104.52,58.77h18.49c24.46,0,105.06-32.86,105.06-62.47s-13.28-48.58-17.96-63.42
								C324.71,140.33,302.94,110.72,278.49,110.72z"></path>
							<path
								id="Mouth"
								class="st4"
								d="M210.56,230.78c0,0,8.89,9.56,21.56,9.56c13.72,0,22.61-8.67,22.61-8.67"></path>
						</g>
						<g id="ArmLeft">
							<line id="ArmLeftPortion" class="st6" x1="196.31" y1="297.13" x2="133" y2="237.89"></line>
							<circle id="HandLeft" class="st5" cx="135.99" cy="221.78" r="28.78"></circle>
						</g>
						<g id="ArmRight">
							<line id="ArmRightPortion" class="st6" x1="267.23" y1="297.13" x2="330.64" y2="236.66"
							></line>
							<circle id="HandRight" class="st7" cx="328.56" cy="221.78" r="28.78"></circle>
						</g>
						<g id="Center">
							<path
								id="CenterBasePath"
								class="st8"
								d="M232.11,196.11c10,0,28.67,9.56,28.67,9.56v-39.11c-3.41-2.39-13.66-8.9-28.22-8.67
								c-13.62,0.22-23.18,6.23-26.67,8.67c0,13.04,0,26.07,0,39.11C205.89,205.67,222.33,196.11,232.11,196.11z"
							></path>
						</g>
						<g id="LeftLens">
							<circle id="BinoBackLeft" class="st8" cx="161.42" cy="177.75" r="56.25"></circle>
							<circle id="BinoBaseLeft" class="st9" cx="161.42" cy="177.92" r="56.25"></circle>
							<circle id="BinoLensOuterLeft" class="st10" cx="161.89" cy="177.75" r="40.02"></circle>
							<circle id="BinoLensInnerLeft" class="st11" cx="174.62" cy="163.55" r="17.32"></circle>
							<circle id="FlareLargeLeft" class="st12" cx="146.17" cy="162.42" r="8.33"></circle>
							<circle id="FlareSmallLeft" class="st12" cx="161" cy="180.45" r="5.66"></circle>
						</g>
						<g id="RightLens">
							<circle id="BinoBackRight" class="st8" cx="303.33" cy="177.92" r="56.25"></circle>
							<circle id="BinoBaseRight" class="st9" cx="303.33" cy="177.75" r="56.25"></circle>
							<circle id="BinoLensOuterRight" class="st10" cx="303.66" cy="178.58" r="40.02"></circle>
							<circle id="BinoLensInnerRight" class="st11" cx="317.09" cy="163.55" r="17.32"></circle>
							<circle id="FlareLargeRight" class="st12" cx="286.81" cy="161.73" r="8.33"></circle>
							<circle id="FlareSmallRight" class="st12" cx="303.56" cy="179.5" r="5.66"></circle>
						</g>
					</svg>
				</div>
				<h1>Ope <span class="one">.</span><span class="two">.</span><span class="three">.</span></h1>
				<p>nothing here</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	import { gsap } from 'gsap';

	// timelines from a previous view-transition navigation must be killed before re-init
	let timelines: gsap.core.Timeline[] = [];

	document.addEventListener('astro:page-load', initAlien);

	function initAlien() {
		if (!document.getElementById('Layer_1')) return;

		timelines.forEach((tl) => tl.kill());
		timelines = [];
		gsap.killTweensOf('#FlareLargeLeft, #FlareSmallLeft, #FlareLargeRight, #FlareSmallRight');

		const baseRepeatDelay = 3;

		function addLoop(
			elementId: string,
			steps: gsap.TweenVars[],
			{ duration = 3, timeScale = 3, repeatDelayScale = 1 } = {},
		) {
			const target = document.getElementById(elementId);
			if (!target) return;
			const tl = gsap
				.timeline({ repeat: -1, repeatDelay: baseRepeatDelay * repeatDelayScale })
				.timeScale(timeScale);
			steps.forEach((vars) => tl.to(target, { ...vars, duration }));
			timelines.push(tl);
		}

		addLoop('LeftLens', [{ xPercent: -25 }, { xPercent: 25 }, { xPercent: 0 }]);
		addLoop('HandLeft', [{ xPercent: -25 }, { xPercent: 25 }, { xPercent: 0 }]);
		addLoop('ArmLeftPortion', [{ attr: { x2: 113 } }, { attr: { x2: 153 } }, { attr: { x2: 133 } }]);
		addLoop('ArmRightPortion', [{ attr: { x2: 310 } }, { attr: { x2: 350 } }, { attr: { x2: 330 } }]);
		addLoop('HandRight', [{ xPercent: -25 }, { xPercent: 25 }, { xPercent: 0 }]);
		addLoop('RightLens', [{ xPercent: -25 }, { xPercent: 25 }, { xPercent: 0 }]);
		addLoop('BinoBackLeft', [{ xPercent: 15 }, { xPercent: -15 }, { xPercent: 0 }]);
		addLoop('BinoBackRight', [{ xPercent: 15 }, { xPercent: -15 }, { xPercent: 0 }]);
		addLoop('Center', [{ xPercent: -18 }, { xPercent: 18 }, { xPercent: 0 }]);
		addLoop('Mouth', [{ xPercent: -20 }, { xPercent: 20 }, { xPercent: 0 }]);
		addLoop(
			'HeadGroup',
			[
				{ rotate: 1, yPercent: 3, transformOrigin: 'top right' },
				{ rotate: 0, yPercent: 0 },
				{ rotate: -1, yPercent: 3, transformOrigin: 'top left' },
				{ rotate: 0, yPercent: 0 },
				{ rotate: 1, yPercent: 3, transformOrigin: 'top right' },
				{ rotate: 0, yPercent: 0 },
			],
			{ timeScale: 6, repeatDelayScale: 2 },
		);
		addLoop(
			'Body',
			[
				{ rotate: 1, yPercent: 3, transformOrigin: 'top right' },
				{ rotate: 0, yPercent: 0 },
				{ rotate: 0, yPercent: 3, transformOrigin: 'top left' },
				{ rotate: 0, yPercent: 0 },
				{ rotate: 1, yPercent: 3, transformOrigin: 'top right' },
				{ rotate: 0, yPercent: 0 },
			],
			{ timeScale: 6, repeatDelayScale: 2 },
		);
		addLoop('Hair', [{ xPercent: 28 }, { xPercent: -22 }, { xPercent: 0 }]);
		addLoop(
			'LeftLegPortion',
			[
				{ attr: { points: '210.67,413.11 205.67,392.78 210.67,366.56' } },
				{ attr: { points: '210.67,413.11 210.67,392.78 210.67,366.56' } },
				{ attr: { points: '210.67,413.11 205.67,392.78 210.67,366.56' } },
				{ attr: { points: '210.67,413.11 210.67,392.78 210.67,366.56' } },
				{ attr: { points: '210.67,413.11 205.67,392.78 210.67,366.56' } },
				{ attr: { points: '210.67,413.11 210.67,392.78 210.67,366.56' } },
			],
			{ timeScale: 6, repeatDelayScale: 2 },
		);
		addLoop(
			'RightLegPortion',
			[
				{ attr: { points: '254.75,413.11 259.75,392.78 254.75,366.56' } },
				{ attr: { points: '254.75,413.11 254.75,392.78 254.75,366.56' } },
				{ attr: { points: '254.75,413.11 259.75,392.78 254.75,366.56' } },
				{ attr: { points: '254.75,413.11 254.75,392.78 254.75,366.56' } },
				{ attr: { points: '254.75,413.11 259.75,392.78 254.75,366.56' } },
				{ attr: { points: '254.75,413.11 254.75,392.78 254.75,366.56' } },
			],
			{ timeScale: 6, repeatDelayScale: 2 },
		);
		addLoop(
			'LeftFoot',
			[
				{ rotate: 0 },
				{ rotate: 0 },
				{ rotate: 0 },
				{ rotate: 0 },
				{ rotate: 20 },
				{ rotate: 0 },
				{ rotate: 20 },
				{ rotate: 0 },
				{ rotate: 0 },
				{ rotate: 0 },
				{ rotate: 0 },
				{ rotate: 0 },
			],
			{ timeScale: 24, repeatDelayScale: 20 },
		);

		const glares: [string, gsap.TweenVars][] = [
			['FlareLargeLeft', { x: '+=2', y: '+=2' }],
			['FlareSmallLeft', { x: '+=2', y: '-=2' }],
			['FlareLargeRight', { x: '-=2', y: '-=2' }],
			['FlareSmallRight', { x: '-=2', y: '+=2' }],
		];
		glares.forEach(([elementId, vars]) => {
			const target = document.getElementById(elementId);
			if (!target) return;
			gsap.to(target, { ...vars, duration: 0.1, yoyo: true, repeat: -1 });
		});
	}
</script>

<style>
	main {
		display: flex;
		justify-content: center;
	}

	.not-found {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		width: 100%;
		padding: 2.5rem 1.5rem 3rem;
	}

	h1 {
		font-family: var(--font-kanit);
		font-weight: 900;
		color: rgb(176, 197, 226);
		text-shadow:
			0 1px 0 #09448f,
			0 2px 0 #093f85,
			0 3px 0 #083b7c,
			0 4px 0 #083672,
			0 5px 0 #073268,
			0 6px 0 #062d5f,
			0 7px 0 #062955,
			0 8px 0 #05244c,
			0 0 5px rgb(0 62 142 / 5%),
			0 -1px 3px rgb(0 62 142 / 20%),
			0 9px 9px rgb(0 62 142 / 30%),
			0 12px 12px rgb(0 62 142 / 30%),
			0 15px 15px rgb(0 62 142 / 30%);
		font-size: 3rem;
		text-align: center;
		width: 100%;
		margin: 0;
	}

	.not-found p {
		text-align: center;
	}

	.svg-container {
		display: inline-block;
		position: relative;
		width: 18em;
		max-width: 100%;
		padding-bottom: 18em;
		vertical-align: middle;
		overflow: hidden;
	}

	.svg-content {
		display: inline-block;
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	#LeftFoot {
		transform-origin: 12px 2px;
	}

	.one,
	.two,
	.three {
		opacity: 0;
		animation: dot 1.3s infinite;
	}
	.two {
		animation-delay: 0.2s;
	}
	.three {
		animation-delay: 0.3s;
	}

	@keyframes dot {
		0% {
			opacity: 0;
		}
		50% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	.st0 {
		filter: var(--shadow);
		fill: none;
		stroke: #019985;
		stroke-width: 23;
		stroke-linecap: round;
		stroke-miterlimit: 10;
	}
	.st1 {
		fill: none;
		stroke: #019985;
		stroke-width: 23;
		stroke-miterlimit: 10;
	}
	.st2 {
		fill: #53c2b6;
		filter: var(--shadow);
	}
	.st3 {
		filter: var(--shadow);
		fill: none;
		stroke: #019985;
		stroke-width: 5;
		stroke-miterlimit: 10;
	}
	.st4 {
		fill: none;
		stroke: #1f3353;
		stroke-width: 8;
		stroke-linecap: round;
		stroke-miterlimit: 10;
	}
	.st5 {
		filter: var(--shadow);
		fill: #059985;
	}
	#ArmLeft {
		filter: var(--shadow);
	}
	.st6 {
		fill: none;
		stroke: #019985;
		stroke-width: 26;
		stroke-linecap: round;
		stroke-miterlimit: 10;
	}
	.st7 {
		filter: var(--shadow);
		fill: #019985;
	}
	.st8 {
		fill: #15263d;
	}
	.st9 {
		fill: #1f3454;
	}
	.st10 {
		fill: #4ac6e7;
	}
	.st11 {
		fill: #6fcee5;
	}
	.st12 {
		fill: #ffffff;
	}
</style>

</style>