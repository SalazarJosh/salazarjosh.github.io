---
import AboutHeroImage from '../assets/low-poly-self-final.png';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BackToTopMonster from '../components/monsters/BackToTopMonster.astro';
---

<html lang="en">
	<head>
		<BaseHead
			title="Josh Salazar | Designer, Developer, Educator"
			description="Meet Josh Salazar: UI/UX designer, developer, accessibility advocate, speaker, and professor."
			image={AboutHeroImage}
		/>
		<style>
			.about-main {
				width: 1080px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 5rem 1rem 7rem;
			}
			.about-hero {
				display: grid;
				grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
				gap: clamp(2rem, 8vw, 7rem);
				align-items: center;
				padding-bottom: 5rem;
				border-bottom: 1px solid var(--rule);
			}
			.portrait {
				margin: 0;
				text-align: center;
			}
			.portrait img {
				width: min(21rem, 100%);
				height: auto;
			}
			.eyebrow,
			.section-label {
				margin: 0 0 0.75rem;
				color: var(--accent-teal);
				font-family: var(--font-mono);
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.about-hero h1 {
				max-width: 9ch;
				margin-bottom: 1rem;
				font-size: clamp(3rem, 8vw, 6rem);
				line-height: 0.95;
			}
			.lede {
				max-width: 34rem;
				margin: 0;
				font-size: 1.2rem;
			}
			.about-sections {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 4rem clamp(2rem, 7vw, 6rem);
				padding-top: 4rem;
			}
			.about-section {
				max-width: 34rem;
			}
			.about-section h2 {
				margin-bottom: 1rem;
				font-size: 1.8rem;
			}
			.about-section p {
				margin-top: 0;
			}
			.talks {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.talks li {
				padding: 0.8rem 0;
				border-top: 1px solid var(--rule);
			}
			.talks li:last-child {
				border-bottom: 1px solid var(--rule);
			}
			@media (max-width: 720px) {
				.about-main {
					padding-top: 3rem;
				}
				.about-hero {
					grid-template-columns: 1fr;
					gap: 2rem;
					padding-bottom: 3rem;
				}
				.portrait {
					order: -1;
				}
				.about-hero h1 {
					font-size: 3.5rem;
				}
				.about-sections {
					grid-template-columns: 1fr;
					gap: 2.5rem;
					padding-top: 3rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="about-main">
			<section class="about-hero" aria-labelledby="about-heading">
				<figure class="portrait">
					<Image src={AboutHeroImage} alt="Portrait of Josh Salazar" />
				</figure>
				<div>
					<p class="eyebrow">// about the maker</p>
					<h1 id="about-heading">Hi, I'm Josh.</h1>
					<p class="lede">
						I'm a designer, developer, educator, and persistent advocate for making the web work better
						for everyone.
					</p>
				</div>
			</section>

			<div class="about-sections">
				<section class="about-section">
					<p class="section-label">01 / the day job</p>
					<h2>Designing and building at Central Michigan University</h2>
					<p>[Add a short overview of your UI/UX Designer / Developer role, collaborators, and work.]</p>
				</section>

				<section class="about-section">
					<p class="section-label">02 / everyone gets in</p>
					<h2>Leading accessibility initiatives in higher education</h2>
					<p>[Describe the initiatives you lead, who they serve, and one outcome or lesson.]</p>
				</section>

				<section class="about-section">
					<p class="section-label">03 / out in the wild</p>
					<h2>Speaking about design, code, and access</h2>
					<ul class="talks">
						<li><strong>UCDA, Portland</strong> [Talk title or topic]</li>
						<li><strong>UCDA, Atlanta</strong> [Talk title or topic]</li>
						<li><strong>Digital Summit, Detroit</strong> [Talk title or topic]</li>
					</ul>
				</section>

				<section class="about-section">
					<p class="section-label">04 / the classroom</p>
					<h2>Teaching graphic design and web design</h2>
					<p>[Add what you teach, how you teach it, and what your students are learning.]</p>
				</section>
			</div>
		</main>
		<Footer />
		<BackToTopMonster />
	</body>
</html>
