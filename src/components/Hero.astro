---
import AboutHeroImage from "../assets/low-poly-self-final.png";
import { Image } from "astro:assets";
import BackToTopMonster from "../components/monsters/BackToTopMonster.astro";
import PictureMonsters from "../components/monsters/PictureMonsters.astro";

---
<section class="about-hero" aria-labelledby="about-heading">
	<figure class="portrait">
		<Image src={AboutHeroImage} alt="Portrait of Josh Salazar" />
		<div class="portrait-flash" aria-hidden="true"></div>
		<div class="picture-monster-container">
			<PictureMonsters />
		</div>
	</figure>
	<div>
		<p class="eyebrow">// about the maker</p>
		<h1 id="about-heading">Hi, I'm Josh.</h1>
		<p class="lede">
			<strong>I'm an <span class="kw">artist</span> for everyone and my medium is <span class="code">&lt;code/&gt;</span>.</strong>
			<br />
			<br />

			designer, developer, educator, and persistent advocate for
			making the web work better for everyone.
		</p>
	</div>
</section>

<div class="about-sections">
	<section class="about-section">
		<p class="section-label">01 / the day job</p>
		<h2>Designing and building at the University of Michigan Library</h2>
		<p>
			I design and build accessible digital experiences for the University of Michigan Library. My work focuses on creating user-friendly interfaces for the Library website's front-end, while contributing to initiatives across accessibility, analytics, and digital projects.
		</p>
	</section>

	<section class="about-section">
		<p class="section-label">02 / access for all</p>
		<h2>Leading accessibility initiatives in higher education</h2>
		<p>
			I've worked with administration to create digital accessibility remediation plans in response to Department of Justice complaints. I also led university-wide accessibility initiatives, developing training for content editors, developers, and designers.
		</p>
	</section>

	<section class="about-section">
		<p class="section-label">03 / out in the wild</p>
		<h2>Speaking about design, code, and access</h2>
		<ul class="talks">
			<li>
				<strong>Digital Summit, Detroit (2019)</strong> How to build for everyone, and why you should care
			</li>
			<li><strong>UCDA, Portland (2019)</strong> UX tips to make your website not suck, How to not get sued — design a website accessible for everyone</li>
			<li><strong>UCDA, Atlanta (2020)</strong> Gamification of UX, Accesssibility Remediation Planning</li>
		</ul>
	</section>

	<section class="about-section">
		<p class="section-label">04 / the classroom</p>
		<h2>Teaching graphic design and web design</h2>
		<p>
				I taught graphic design and web design at Central Michigan University, where I shared my knowledge and experience with students. My courses covered a range of topics, including user experience design, front-end development, and accessibility.
		</p>
	</section>
</div>
<BackToTopMonster />


<style>
	.picture-monster-container{
		position: absolute;
		top: 112%;
		right: 270px;
		width: 200px;
		height: 200px;
		z-index: 1000;
		transform: translateY(-50%);
		pointer-events: none;
	}
	
	.lede .kw {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 1rem;
		background: linear-gradient(transparent 62%, rgba(52, 213, 146, 0.22) 62%);
		padding: 0 0.15em;
		vertical-align: 0.12em;
		letter-spacing: 0;
	}

	.lede .code {
		color: white;
		border-radius: 4px;
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 1rem;
		background: rgb(33, 33, 33);
		padding: 0 0.15em;
		vertical-align: 0.12em;
		letter-spacing: 0;
	}
	.about-main {
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 5rem 1rem 7rem;
	}
	.about-hero {
		display: grid;
		grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(2rem, 8vw, 7rem);
		align-items: center;
		padding-bottom: 5rem;
		border-bottom: 1px solid var(--rule);
	}
	.portrait {
		position: relative;
		margin: 0;
		text-align: center;
	}
	.portrait img {
		position: relative;
		z-index: 1;
		width: min(21rem, 100%);
		height: auto;
	}
	.portrait-flash {
		position: absolute;
		z-index: 2;
		inset: 0;
		background: linear-gradient(45deg, rgba(255,255,255, 0.5), rgba(255,255,255,0));
		border-radius: 50%;
		opacity: 0;
		pointer-events: none;
	}
	.eyebrow,
	.section-label {
		margin: 0 0 0.75rem;
		color: var(--accent-teal);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.about-hero h1 {
		max-width: 9ch;
		margin-bottom: 1rem;
		font-size: clamp(3rem, 8vw, 6rem);
		line-height: 0.95;
	}
	.lede {
		max-width: 34rem;
		margin: 0;
		font-size: 1.2rem;
	}
	.about-sections {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 4rem clamp(2rem, 7vw, 6rem);
		padding-top: 4rem;
	}
	.about-section {
		max-width: 34rem;
	}
	.about-section h2 {
		margin-bottom: 1rem;
		font-size: 1.8rem;
	}
	.about-section p {
		margin-top: 0;
	}
	.talks {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.talks li {
		padding: 0.8rem 0;
		border-top: 1px solid var(--rule);
	}
	.talks li:last-child {
		border-bottom: none;
	}
	@media (max-width: 720px) {
		.about-main {
			padding-top: 3rem;
		}
		.about-hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-bottom: 3rem;
		}
		.portrait {
			order: -1;
		}
				.picture-monster-container {
					right: 57%;
					width: 76px;
					height: 76px;
				}
		.about-hero h1 {
			font-size: 3.5rem;
		}
		.about-sections {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			padding-top: 3rem;
		}
	}
</style>