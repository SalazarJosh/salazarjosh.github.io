<script>
  import gsap from "gsap";

  let animationRun = 0;

  document.addEventListener("astro:page-load", animatePictureMonsters);

  function animatePictureMonsters() {
    animationRun += 1;
    const currentRun = animationRun;
    const cameraOne = document.querySelector<SVGGElement>("#camera1");
    const cameraTwo = document.querySelector<SVGGElement>("#camera2");
    const rightMonsterShadow = document.querySelector<SVGGElement>("#rightMonsterShadow");
    const leftMonsterShadow = document.querySelector<SVGGElement>("#LeftMonsterShadow");
    const rightMonsterFlash = document.querySelector<SVGCircleElement>("#RightMonsterFlash");
    const leftMonsterFlash = document.querySelector<SVGCircleElement>("#LeftMonsterFlash");
    const flash = document.querySelector<HTMLElement>(".portrait-flash");

    if (
      !cameraOne ||
      !cameraTwo ||
      !rightMonsterShadow ||
      !leftMonsterShadow ||
      !rightMonsterFlash ||
      !leftMonsterFlash ||
      !flash
    ) return;

    const animationTargets = [
      cameraOne,
      cameraTwo,
      rightMonsterShadow,
      leftMonsterShadow,
      rightMonsterFlash,
      leftMonsterFlash,
      flash,
    ];

    gsap.killTweensOf(animationTargets);
    gsap.set(
      [rightMonsterShadow, leftMonsterShadow, rightMonsterFlash, leftMonsterFlash],
      { opacity: 0 },
    );

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const randomBetween = (minimum: number, maximum: number) =>
      minimum + Math.random() * (maximum - minimum);

    const animateCamera = (
      camera: SVGGElement,
      monsterShadow: SVGGElement,
      monsterFlash: SVGCircleElement,
    ) => {
      if (currentRun !== animationRun) return;

      gsap.timeline({
        delay: randomBetween(0.5, 2.5),
        onComplete: () => animateCamera(camera, monsterShadow, monsterFlash),
      })
        .to(camera, {
          y: randomBetween(8, 14),
          duration: randomBetween(0.35, 0.55),
          ease: "power2.inOut",
        })
        .to({}, { duration: randomBetween(0.7, 2) })
        .to(camera, {
          y: 0,
          duration: randomBetween(0.35, 0.55),
          ease: "power2.out",
        })
        .to([monsterShadow, monsterFlash], {
          opacity: 1,
          duration: 0.05,
          ease: "power1.out",
        })
        .to(flash, {
          opacity: 0.8,
          duration: 0.06,
          yoyo: true,
          repeat: 1,
          ease: "power2.out",
        }, "<")
        .to([monsterShadow, monsterFlash], {
          opacity: 0,
          duration: 0.25,
          ease: "power1.out",
        })
        .to({}, { duration: randomBetween(1.5, 4) });
    };

    animateCamera(cameraOne, rightMonsterShadow, rightMonsterFlash);
    animateCamera(cameraTwo, leftMonsterShadow, leftMonsterFlash);
  }
</script>