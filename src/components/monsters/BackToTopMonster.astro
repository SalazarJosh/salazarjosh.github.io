<style>
    .back-to-top-container {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        width: 10rem;
        height: 10rem;
        cursor: pointer;
        z-index: 1000;
        transform: translateY(calc(100% + 2rem));
        transition:
            transform 0.5s ease,
            bottom 0.2s ease;
    }

    .back-to-top-container.is-visible {
        transform: translateY(0);
    }

    .back-to-top-container svg {
        width: 100%;
        height: 100%;
    }
</style>

<script>
    import gsap from "gsap";

    // module-level so re-init on view-transition navigation replaces the previous listener
    let scrollHandler: (() => void) | null = null;

    document.addEventListener("astro:page-load", initBackToTopMonster);

    //click listener for the back to top monster
    document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (target.closest(".back-to-top-container")) {
            window.scrollTo({ top: 0, behavior: "smooth" });
        }
    });

    function initBackToTopMonster() {
        const container = document.querySelector<HTMLElement>(
            ".back-to-top-container",
        );
        const footer = document.querySelector<HTMLElement>("footer");
        if (!container) return;

        gsap.killTweensOf(".cls-6");
        container
            .querySelectorAll<SVGCircleElement>(".cls-6")
            .forEach((glare) => {
                gsap.to(glare, {
                    x: "+=1",
                    y: "+=1",
                    duration: 0.1,
                    yoyo: true,
                    repeat: -1,
                });
            });

        if (scrollHandler) window.removeEventListener("scroll", scrollHandler);

        const baseGap = 16;
        let revealed = false;
        let ticking = false;

        function updatePosition() {
            ticking = false;
            if (!revealed && window.scrollY > 0) {
                revealed = true;
                container?.classList.add("is-visible");
            }

            if (revealed && window.scrollY === 0) {
                revealed = false;
                container?.classList.remove("is-visible");
            }

            if (!footer || !container) return;
            const footerTop = footer.getBoundingClientRect().top;
            const overlap = window.innerHeight - footerTop;
            container.style.bottom =
                overlap > baseGap ? `${overlap + baseGap}px` : "1rem";
        }

        scrollHandler = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(updatePosition);
            }
        };

        window.addEventListener("scroll", scrollHandler, { passive: true });
        updatePosition();
    }
</script>
