---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">$ cd ~</HeaderLink>
			<HeaderLink href="/blog">$ tail <strong>blog</strong>/*.md</HeaderLink>
			<HeaderLink href="/about">$ cat <strong>about</strong>.txt</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://codepen.io/joshsalazar" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Josh Salazar on CodePen</span>
				<svg viewBox="0 0 512 512" aria-hidden="true" width="28" height="28" astro-icon="social/codepen"
					><path
						fill="currentColor"
						d="M502.285 159.703l-234-156a20.1 20.1 0 0 0-22.6 0l-234 156A19.99 19.99 0 0 0 2.685 176v160a19.999 19.999 0 0 0 8.9 16.6l234 157.4a20.11 20.11 0 0 0 22.4 0l234-157.4a19.999 19.999 0 0 0 8.9-16.6V176a19.99 19.99 0 0 0-8.6-16.297zM278.285 60.703l172.7 115.14-76.5 51.36-96.2-64.42zm-44 0v102.08l-96.2 64.42-76.5-51.36zm-192.6 151.997l55.2 37-55.2 37zm192.6 220.897l-172.7-115.14 76.5-51.36 96.2 64.42zm22-140.6l-96.9-65 96.9-65 96.9 65zm22 140.6v-102.08l96.2-64.42 76.5 51.36zm192.6-183.897l-55.2-37 55.2-37z"
					></path></svg
				>
			</a>
			<a href="https://github.com/SalazarJosh" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Josh Salazar on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a
				href="https://www.linkedin.com/in/josh-salazar-605369387/"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="sr-only">Josh Salazar on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
					><path
						fill="currentColor"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	.internal-links a {
		font-size: 1rem;
		color: #333;
	}
	
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1rem 0.5rem;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent-blue);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
